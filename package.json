{
  "name": "soft-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "scrape:jerusalem": "tsx scripts/scrape-jerusalem-arnona.ts",
    "scrape:telaviv": "tsx scripts/scrape-telaviv.ts",
    "scrape:kolzchut": "tsx scripts/scrape-kolzchut-moving-guide.ts",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
