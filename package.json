    "dev:frontend": "npm run dev --prefix frontend"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@supabase/supabase-js": "^2.108.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
